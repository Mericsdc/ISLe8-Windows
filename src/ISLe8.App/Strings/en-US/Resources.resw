  </data>
  <data name="Settings_FramesNote" xml:space="preserve">
    <value>Windows shows frame rates only to programs running as administrator and to members of "{0}". Run this command once in a terminal opened as administrator, then sign out and back in. While MSI Afterburner's RivaTuner Statistics Server runs, FPS comes from it with no permission needed.</value>
  </data>
  <data name="Settings_FramesCommand" xml:space="preserve">
    <value>net localgroup "{0}" "{1}" /add</value>
  </data>
