<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ISLe8 for Windows. WinUI 3 with the UI built in C# (no .xaml files): the XAML compiler never
    runs, so the same C# also compiles on macOS as a check (scripts/check-on-mac.sh).

    Visual Studio: F5 runs it packaged (MSIX). Command line, unpackaged:
      dotnet run -p:Platform=x64 -p:Unpackaged=true
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>ISLe8</RootNamespace>
    <AssemblyName>ISLe8</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- scripts/make-icons.ps1 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Lightness: no JIT, trimmed. Applies to dotnet publish and to app packages. -->
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The Windows App SDK travels with ISLe8, in the package as in the zip: nothing else to install. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- -p:Unpackaged=true: a plain .exe with the Windows App SDK beside it; no install, no identity.
       Everything but the notification mirror and the startup task works this way. -->
  <PropertyGroup Condition="'$(Unpackaged)' == 'true'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Published too: the unpackaged zip loads the tray and window icons from Assets at run time. -->
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Windows App SDK 2.5.1, only the parts ISLe8 uses, at the versions the Microsoft.WindowsAppSDK
       metapackage pins (Runtime checks they match). The metapackage would also bring AI, ML
       (onnxruntime, DirectML), Search, Widgets and DWriteCore: most of the download, none of it used. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ISLe8.Core\ISLe8.Core.csproj" />
  </ItemGroup>

  <!-- Lets Visual Studio deploy and debug the single-project MSIX. -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' And '$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' And '$(EnableMsixTooling)' == 'true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

</Project>
